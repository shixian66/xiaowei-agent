# 变量名文档。M1 的 load_settings() 不读取 .env，只读进程环境变量；
# 本文件仅用于说明变量名与安全默认值。使用方式见 README。
#
# 未在此列出的 XIAOWEI_* 变量会被 fail-fast 拒绝。
# 固定开发租户是代码常量，没有对应环境变量。

XIAOWEI_ENVIRONMENT_ID=dev
XIAOWEI_ACTOR=local-developer
XIAOWEI_LOG_LEVEL=INFO
XIAOWEI_LEASE_TTL_SECONDS=60
XIAOWEI_HEARTBEAT_INTERVAL_SECONDS=10
XIAOWEI_TASK_FAILURE_LIMIT=3
XIAOWEI_INFRASTRUCTURE_BACKOFF_BASE_SECONDS=1
XIAOWEI_INFRASTRUCTURE_BACKOFF_CAP_SECONDS=30
XIAOWEI_CONTINUOUS_INFRASTRUCTURE_FAILURE_WINDOW_SECONDS=900
XIAOWEI_WORKER_POLL_INTERVAL_SECONDS=1
XIAOWEI_DISPATCH_BATCH_LIMIT=10
XIAOWEI_API_REQUEST_BODY_LIMIT_BYTES=131072
XIAOWEI_POSTGRES_HOST=postgres
XIAOWEI_POSTGRES_PORT=5432
XIAOWEI_POSTGRES_DATABASE=xiaowei
XIAOWEI_POSTGRES_USER=xiaowei
XIAOWEI_POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
XIAOWEI_DB_CONNECT_TIMEOUT_SECONDS=5
XIAOWEI_DB_COMMAND_TIMEOUT_SECONDS=15
XIAOWEI_DB_POOL_SIZE=5
XIAOWEI_DB_POOL_MAX_OVERFLOW=0
XIAOWEI_API_BIND_HOST=127.0.0.1
XIAOWEI_API_BIND_PORT=8000
# 仅供 Compose smoke；生产配置必须保持 false。
XIAOWEI_SMOKE_STEP_BARRIER=false

# M6b StarRocks 默认为 recording；以下空项不激活真实连接。
XIAOWEI_STARROCKS_ADAPTER_MODE=recording
XIAOWEI_STARROCKS_HOST=
XIAOWEI_STARROCKS_PORT=
XIAOWEI_STARROCKS_DATABASE=
XIAOWEI_STARROCKS_USER=
XIAOWEI_STARROCKS_PASSWORD_FILE=
XIAOWEI_STARROCKS_TLS_MODE=
XIAOWEI_STARROCKS_CA_FILE=
XIAOWEI_STARROCKS_SERVER_NAME=
XIAOWEI_STARROCKS_RESOURCE_ID=
XIAOWEI_STARROCKS_EXPECTED_GRANTS_SHA256=
XIAOWEI_STARROCKS_EXPECTED_DDL_SHA256=
XIAOWEI_STARROCKS_EXPECTED_IDENTITY_SHA256=
XIAOWEI_STARROCKS_EXPECTED_METADATA_SOURCE_REF=
XIAOWEI_STARROCKS_PHYSICAL_IDENTITY_REF=
XIAOWEI_STARROCKS_AUTHORIZED_ACTOR=
XIAOWEI_STARROCKS_ACTIVE_FROM=
XIAOWEI_STARROCKS_ACTIVE_UNTIL=
XIAOWEI_STARROCKS_CONNECT_TIMEOUT_SECONDS=
XIAOWEI_STARROCKS_READ_TIMEOUT_SECONDS=
XIAOWEI_STARROCKS_WRITE_TIMEOUT_SECONDS=
XIAOWEI_STARROCKS_QUERY_TIMEOUT_SECONDS=
