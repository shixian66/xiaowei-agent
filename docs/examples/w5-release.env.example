# W5 provider-off release 部署模板（脱敏）。复制到仓库外的私有位置填写，不提交真实值。
#
#   python -m scripts.release_compose --env-file <填好的模板>
#   docker compose --env-file <填好的模板> -f docker-compose.yml -f docker-compose.release.yml ...
#
# 只有下面六个键；多一个、少一个或留空，部署前检查与 Compose 渲染都会失败。
# 这些值只用于 Compose 插值，不进入任何容器环境。运行形态、作用域 dev-local/dev、
# StarRocks disabled 与全部真实调用开关由 docker-compose.release.yml 写死，本模板改不动。

# 不可变镜像：<registry>/<name>@sha256:<64 位小写十六进制>；不接受 tag。
XIAOWEI_RELEASE_IMAGE=
# 部署 actor（本地管理员审计中的操作者名）。
XIAOWEI_RELEASE_ACTOR=
# 构建该镜像的 40 位 source commit SHA；写进容器标签，供部署证据 readback。
XIAOWEI_RELEASE_SOURCE_SHA=
# edge 限流证据记录的引用（见 docs/checklists/w5-edge-rate-limit-evidence.md）。
XIAOWEI_RELEASE_EDGE_EVIDENCE_REF=
# Web 在宿主上的绑定地址：edge 所在的规范 loopback 或 RFC1918 IPv4
# （127/8、10/8、172.16/12、192.168/16）；公网、link-local、IPv6、主机名与 0.0.0.0 一律拒绝。
XIAOWEI_RELEASE_WEB_BIND_IP=
# 已有 HTTPS SSO 的 public origin，形如 https://<host>[:port]；必须是主机名，
# 不带路径、query、fragment 或 userinfo（与 Web 进程启动时的规则相同）。
XIAOWEI_WEB_PUBLIC_ORIGIN=
